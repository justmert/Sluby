# Database
DATABASE_URL=postgresql://sluby:sluby@localhost:5432/sluby

# Redis
REDIS_URL=redis://localhost:6379

# Sia Storage
# indexd application API. This is what the backend's sia-storage SDK talks to.
# Inside Docker use the container hostname instead: http://sia-indexd:9982
SIA_INDEXER_URL=http://127.0.0.1:9982
# indexd admin API (HTTP Basic). Used for out-of-band reads the SDK does not
# expose, such as the wallet address and the contract list.
SIA_ADMIN_URL=http://127.0.0.1:9980
# Password for the admin API above. Matches `adminAPI.password` in indexd's
# own config file (the value you chose in the indexd config wizard).
SIA_ADMIN_PASSWORD=
SIA_APP_ID=your_64_char_hex_app_id_here
SIA_APP_KEY=your_hex_app_key_here
# Erasure-coding shards per slab. 2 data + 4 parity fits the Zen testnet's
# small host pool. Mainnet typically runs 10 data + 20 parity.
SIA_DATA_SHARDS=2
SIA_PARITY_SHARDS=4
# Which network the connected indexd runs against: zen, mainnet, testnet, anagami.
SIA_NETWORK=zen

# Server
PORT=3000
HOST=0.0.0.0
# Optional: comma-separated allowlist of browser origins for the REST API.
# Leave empty to reflect whatever origin the request came from (dev default).
# In production set it to your public site origin, e.g. https://your.domain
CORS_ORIGIN=

# Upload configuration
UPLOAD_DIR=./uploads
TRANSCODE_OUTPUT_DIR=./transcode-output
MAX_UPLOAD_SIZE=10737418240

# Cache
CACHE_DIR=./cache
CACHE_MAX_SIZE_MB=10240

# API
API_RATE_LIMIT_PER_MIN=100

# Reconciliation worker (compares the DB against the indexer inventory)
# Set RECONCILE_ENABLED=false to disable the periodic sweep (the on-demand
# API trigger still works). Interval is in milliseconds (default hourly).
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=3600000
RECONCILE_PAGE_SIZE=500

# Bootstrap API key (optional)
# If set and no keys exist in the DB, this key is auto-seeded on startup
# with full scopes (upload, read, manage). Solves the bootstrap problem.
# Generate a key: node -e "console.log('sluby_'+require('crypto').randomBytes(32).toString('base64url'))"
# BOOTSTRAP_API_KEY=sluby_your_key_here

# --- GitHub OAuth (Studio sign-in) ---
# Register a GitHub OAuth app at https://github.com/settings/developers
#   Homepage URL:        https://your.domain
#   Callback URL:        https://your.domain/api/v1/auth/github/callback
# PUBLIC_URL is the URL the browser uses. In dev: http://localhost:3000.
PUBLIC_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign in. Empty = no one.
GITHUB_ALLOWED_USERS=
# HMAC secret for signed session cookies. Rotate to invalidate sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-do-not-use-in-production-change-me
# Set to "true" to bypass the GitHub auth gate (local dev only).
AUTH_DISABLED=false

# --- Optional: local Sia indexer stack (docker-compose.sia.yml) ---
# Password for the dedicated Postgres that backs indexd.
# INDEXD_POSTGRES_PASSWORD=change_me
# Admin password for walletd's API (used by cpuminer).
# WALLETD_API_PASSWORD=1234
# Wallet address that Zen-testnet block rewards are paid to.
# MINER_ADDRESS=addr:...
