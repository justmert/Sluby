# docker compose reads this file. copy it to .env and fill in what you need.
# defaults below are for the local stack (http://localhost:8080).

# --- sia indexer ---------------------------------------------------------
# the hosted mainnet indexer. a free sia.storage account works.
SIA_INDEXER_URL=https://sia.storage
SIA_NETWORK=mainnet
# your app's identity on the indexer. get both with:
#   docker compose run --rm --no-deps backend node scripts/connect-indexer.mjs
SIA_APP_ID=
SIA_APP_KEY=
# leave both unset for the sdk default of 10 data + 20 parity shards, spread
# over 30 hosts. set both only to fit a smaller pool, such as the zen testnet;
# the configuration reference has the details
# (docs/content/docs/self-hosting/configuration.mdx).
# SIA_DATA_SHARDS=
# SIA_PARITY_SHARDS=
# self-hosted indexd only: its admin api adds contract ids and the wallet to
# the storage breakdown
# SIA_ADMIN_URL=http://sia-indexd:9980
# SIA_ADMIN_PASSWORD=

# --- studio sign-in --------------------------------------------------------
# members sign in with an email and password. on the first visit the studio
# asks for the setup code the backend logs at startup
# (docker compose logs backend | grep "setup code") and creates the first
# admin; everyone else joins through invite links an admin makes there.
# AUTH_DISABLED=true skips sign-in and signs every visitor in as a local
# admin, for a stack only you can reach; the backend refuses it in production.
AUTH_DISABLED=false
# optional: github sign-in for members and invited people (never for anyone
# else). create an oauth app at https://github.com/settings/developers with
# the callback
#   https://<your domain>/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USERS and OPERATOR_USERS from older versions are read once,
# on the first start after the upgrade (accounts the allowlist refused are
# removed, listed operators become admins), then ignored. remove them after.
# signs session cookies (and, through a derived key, private playback urls),
# 32+ characters. unset, the backend generates one on its first
# start and keeps it in its database, so sessions survive a restart;
# production requires it.
# generate one with:
#   openssl rand -base64 32
# SESSION_SECRET=

# --- webhooks ---------------------------------------------------------------
# webhooks only reach public addresses. list the networks (cidrs) of
# receivers on your own network, e.g. 10.0.5.0/24,fd00:5::/64
# WEBHOOK_ALLOWED_NETWORKS=

# --- production (docker-compose.prod.yml) ---------------------------------
# DOMAIN=video.example.com
# ACME_EMAIL=you@example.com
# POSTGRES_PASSWORD=

# --- browsers, client addresses and limits -------------------------------
# empty takes the default; the configuration reference
# (docs/content/docs/self-hosting/configuration.mdx) has the details.
# origins whose pages may use the studio session cookie across origins (the
# production override sets https://DOMAIN); any other origin can still call
# the api with a key
# CORS_ORIGIN=
# proxy hops the backend trusts for the client address (private networks)
# TRUST_PROXY=loopback, linklocal, uniquelocal
# per client address and minute, api calls without a valid key or session
# API_IP_RATE_LIMIT=600
# the most an api key's rate_limit can be, and keys per account
# API_KEY_RATE_LIMIT_MAX=10000
# API_KEYS_PER_ACCOUNT_MAX=100
# bearer token GET /metrics then requires, on the backend port and through
# the web proxy. unset, the proxy answers /metrics with 404
# METRICS_TOKEN=
# per client address at the web proxy: delivery (/v1/) and sign-in
# (/api/v1/auth/ and /metrics) request rate, burst above it and open connections
# WEB_DELIVERY_RATE=100r/s
# WEB_DELIVERY_BURST=400
# WEB_DELIVERY_CONN=200
# WEB_AUTH_RATE=10r/s
# WEB_AUTH_BURST=50
# WEB_AUTH_CONN=20

# --- backend from source (npm run dev) -----------------------------------
# compose sets its own values inside the containers; these only apply when
# the backend runs on the host against the compose postgres and redis, which
# docker-compose.dev.yml publishes on these ports
# DATABASE_URL=postgresql://sluby:sluby@localhost:5433/sluby
# REDIS_URL=redis://localhost:6380

# --- optional ------------------------------------------------------------
# port of the local stack on 127.0.0.1. change PUBLIC_URL to match, since
# upload and sign-in urls are built from it
# WEB_PORT=8080
# PUBLIC_URL=http://localhost:8080
# an api key with every scope, seeded before the backend takes requests. once
# deleted or rotated it is never seeded again; set a new value to get another.
# production needs a generated one:
#   node -e "console.log('sluby_' + require('crypto').randomBytes(32).toString('base64url'))"
# BOOTSTRAP_API_KEY=
# publishable viewer identity so the studio player streams straight from sia.
# these are built into the studio, so run `docker compose build web` after
# changing them:
#   docker compose run --rm --no-deps backend node scripts/provision-viewer.mjs
# VITE_SLUBY_SIA_INDEXER_URL=
# VITE_SLUBY_SIA_APP_ID=
# VITE_SLUBY_SIA_APP_KEY=
# the sia explorer for host and contract links (defaults to the one matching SIA_NETWORK)
# VITE_SIA_EXPLORER_URL=
# a custom-built sia-storage native binary under backend/vendor/ (see backend/vendor/README.md)
# SIA_STORAGE_NATIVE=
