# Database
DATABASE_URL=postgresql://siastream:siastream@localhost:5432/siastream

# Redis
REDIS_URL=redis://localhost:6379

# Sia Storage
SIA_INDEXER_URL=https://sia.storage
SIA_APP_ID=your_64_char_hex_app_id_here
SIA_APP_KEY=your_64_char_hex_app_key_here

# Server
PORT=3000
HOST=0.0.0.0

# Upload Configuration
UPLOAD_DIR=./uploads
TRANSCODE_OUTPUT_DIR=./transcode-output
MAX_UPLOAD_SIZE=10737418240

# Cache
CACHE_DIR=./cache
CACHE_MAX_SIZE_MB=10240

# API
API_RATE_LIMIT_PER_MIN=100

# Bootstrap API Key (optional)
# If set and no keys exist in the DB, this key is auto-seeded on startup.
# Generate a key: node -e "console.log('wss_'+require('crypto').randomBytes(32).toString('base64url'))"
# BOOTSTRAP_API_KEY=wss_your_key_here
