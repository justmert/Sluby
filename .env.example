# docker compose reads this file. copy it to .env and fill in what you need.
# defaults below are for the local stack (http://localhost:8080).

# --- sia indexer ---------------------------------------------------------
# the hosted mainnet indexer. a free sia.storage account works.
SIA_INDEXER_URL=https://sia.storage
SIA_NETWORK=mainnet
# your app's identity on the indexer. get both with:
#   docker compose run --rm backend node scripts/connect-indexer.mjs
SIA_APP_ID=
SIA_APP_KEY=
# leave both unset to use the indexer account's redundancy (required on
# mainnet). set them only for a small testnet host pool, see docs/deployment.
# SIA_DATA_SHARDS=
# SIA_PARITY_SHARDS=
# self-hosted indexd only: its admin api adds contract ids and the wallet to
# the storage breakdown
# SIA_ADMIN_URL=http://sia-indexd:9980
# SIA_ADMIN_PASSWORD=

# --- studio sign-in --------------------------------------------------------
# local stack: sign everyone in as a dev user. the stack only listens on
# localhost, and the backend refuses this in production.
AUTH_DISABLED=true
# production: github sign-in. create an oauth app at
# https://github.com/settings/developers with the callback
#   https://<your domain>/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# comma-separated github logins allowed in; empty lets any github account in
# GITHUB_ALLOWED_USERS=
# signs session cookies, 32+ characters. generate one with:
#   openssl rand -base64 32
# SESSION_SECRET=

# --- production (docker-compose.prod.yml) ---------------------------------
# DOMAIN=video.example.com
# ACME_EMAIL=you@example.com
# POSTGRES_PASSWORD=

# --- backend from source (npm run dev) -----------------------------------
# compose sets its own values inside the containers; these only apply when
# the backend runs on the host against the compose postgres and redis
# DATABASE_URL=postgresql://sluby:sluby@localhost:5433/sluby
# REDIS_URL=redis://localhost:6380

# --- optional ------------------------------------------------------------
# port of the local stack on 127.0.0.1
# WEB_PORT=8080
# seed one api key with every scope on first start (when no keys exist)
# BOOTSTRAP_API_KEY=
# publishable viewer identity so the studio player streams straight from sia:
#   docker compose run --rm backend node scripts/provision-viewer.mjs
# VITE_SLUBY_SIA_INDEXER_URL=
# VITE_SLUBY_SIA_APP_ID=
# VITE_SLUBY_SIA_APP_KEY=
# the sia explorer for host and contract links (defaults to the one matching SIA_NETWORK)
# VITE_SIA_EXPLORER_URL=
# a custom-built sia-storage native binary under backend/vendor/ (see backend/vendor/README.md)
# SIA_STORAGE_NATIVE=
