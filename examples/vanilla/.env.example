# Sluby API base URL, or the URL of your own signing server (server/signing-server.mjs).
VITE_SLUBY_BASE_URL=http://localhost:8080

# Where the browser fetches HLS bytes from (the Sluby gateway). Set it when the
# base URL above is your own server. Blank reuses the base URL.
VITE_SLUBY_DELIVERY_URL=

# For uploading and deleting; playback, direct from Sia included, needs none.
# Only for local development. A key in a browser bundle is readable by anyone
# who loads the page; see the plain JavaScript guide for the safe setup.
VITE_SLUBY_API_KEY=

# Direct-from-Sia playback (optional). A viewer identity from
# `npm run provision-viewer` in backend/. These three are publishable, and no
# API key is needed with them.
VITE_SLUBY_SIA_INDEXER_URL=
VITE_SLUBY_SIA_APP_ID=
VITE_SLUBY_SIA_APP_KEY=
