# Sluby API base URL (the REST API).
VITE_SLUBY_BASE_URL=http://localhost:8080

# Delivery base URL the browser fetches HLS bytes from directly (the object
# gateway or an nginx cache in front of it). Leave blank to reuse the API base.
VITE_SLUBY_DELIVERY_URL=

# A Sluby API key with read + upload + manage scopes. Only for local
# development: a key in a browser bundle is readable by anyone who loads the
# page. See the React guide for the safe setup.
VITE_SLUBY_API_KEY=

# Direct-from-Sia playback (optional). Set all three to stream video bytes
# straight from Sia in the browser (the backend leaves the byte path); leave
# them blank to use the gateway. Provision a low-privilege viewer identity with
# `npm run provision-viewer` in the backend. All three are publishable, like a
# public playback key.
VITE_SLUBY_SIA_INDEXER_URL=
VITE_SLUBY_SIA_APP_ID=
VITE_SLUBY_SIA_APP_KEY=
