{
  "name": "@sluby/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the Sluby video API: assets, resumable tus uploads, playback URLs, keys, webhooks and direct-from-Sia playback.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "sluby",
    "sia",
    "video",
    "hls",
    "tus",
    "upload",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justmert/Sluby.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/justmert/Sluby/tree/main/packages/sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../../' + f, f)\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@siafoundation/sia-storage": "^0.1.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "playwright": "^1.64.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "bugs": {
    "url": "https://github.com/justmert/Sluby/issues"
  }
}
