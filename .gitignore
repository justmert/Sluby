# dependencies
node_modules/

# builds
dist/
build/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# logs
*.log

# runtime data / local state
uploads/
transcode-output/
cache/
pgdata/
redis-data/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# turborepo cache
.turbo/

# docs site (next.js static export)
docs/.next/
docs/out/
docs/next-env.d.ts

# media & test fixtures
*.mp4
*.pdf
/test/
/test-output/
# vitest browser mode failure screenshots
.vitest/

# vendored binaries (the readme stays tracked so the docker build always has the dir)
backend/vendor/*

# unused apps
demo-app/
reference-app/

# local reference docs / notes / research / reports (keep README + CONTRIBUTING)
*.md
!README.md
!CONTRIBUTING.md
!packages/*/CHANGELOG.md
!backend/vendor/README.md
!docs/**/*.md
sia/

# internal working artifacts (plans, notes, scratch)
resources/

# claude code agent worktrees
.claude/worktrees/

# license texts copied into the packages at pack time
packages/*/LICENSE
packages/*/NOTICE
# built from docs/public/skills/<name>/ by the docs build
docs/public/skills/*.zip
