# Where `npm run dev` proxies /api and /v1 (the Sluby backend). The Studio is
# served from the same origin as the API, so the session cookie reaches every
# request. Point the backend's PUBLIC_URL at the Studio origin
# (http://localhost:5173 in dev) so GitHub sign-in returns here.
STUDIO_API_PROXY_TARGET=http://localhost:3000

# Optional: direct-from-Sia playback in the Studio player. A publishable viewer
# identity from `npm run provision-viewer --workspace=backend`. Without it the
# player streams through the backend gateway.
# VITE_SLUBY_SIA_INDEXER_URL=https://sia.storage
# VITE_SLUBY_SIA_APP_ID=
# VITE_SLUBY_SIA_APP_KEY=

# Optional: Sia explorer for host and contract links. Unset, the Studio picks
# Siascan for the network the backend reports (zen.siascan.com on Zen and
# testnet, siascan.com otherwise).
# VITE_SIA_EXPLORER_URL=
