# Sluby backend base URL
VITE_API_BASE_URL=http://localhost:4500

# API key used to authenticate against the Sluby backend
VITE_API_KEY=

# Optional: override the Sia explorer used for object / host / contract links
# Defaults to https://zen.siascan.com (Zen testnet). Use https://siascan.com for mainnet.
# VITE_SIA_EXPLORER_URL=

# Optional: override the renterd base URL (defaults to http://localhost:9980)
# VITE_SIA_RENTERD_URL=
