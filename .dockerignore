# the build context is the repo root, so keep it to sources and manifests.
# patterns start with **/ to match in every directory, not only the root
**/node_modules
**/dist
**/*.tsbuildinfo
.git
.github
.claude
# env files anywhere: a frontend .env would otherwise reach the studio build,
# which inlines every VITE_ variable it finds
**/.env
**/.env.*
!**/.env.example
**/uploads
**/transcode-output
**/cache
resources
sia
demo-app
reference-app
docs
**/*.md
**/*.mp4
**/coverage
**/.vitest
