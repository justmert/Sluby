{
  "name": "sluby-backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed-key": "tsx src/db/seed-api-key.ts",
    "provision-viewer": "node scripts/provision-viewer.mjs",
    "connect-indexer": "node scripts/connect-indexer.mjs",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@siafoundation/sia-storage": "^0.1.2",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "lru-cache": "^11.0.0",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@scalar/api-reference": "1.73.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
